<?xml version="1.0" encoding="UTF-8"?>
<!-- A manuscript for the LibreOffice oracle (P7-03, D-048): test/docx-oracle.test.js converts it to .docx. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta><dc:title>The Oracle Manuscript</dc:title><meta:initial-creator>Ora Cle</meta:initial-creator><dc:creator>Ora Cle</dc:creator><dc:language>en-GB</dc:language></office:meta>
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph"/>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:default-outline-level="1"/>
  <style:style style:name="Heading_20_2" style:display-name="Heading 2" style:family="paragraph" style:default-outline-level="2"/>
  <style:style style:name="Quotations" style:family="paragraph"/>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  <style:style style:name="I" style:family="text"><style:text-properties fo:font-style="italic"/></style:style>
  <style:style style:name="SC" style:family="text"><style:text-properties fo:font-variant="small-caps"/></style:style>
  <text:list-style style:name="Bul"><text:list-level-style-bullet text:level="1" text:bullet-char="•"/><text:list-level-style-number text:level="2" style:num-format="1"/></text:list-style>
  <text:list-style style:name="Num"><text:list-level-style-number text:level="1" style:num-format="1"/></text:list-style>
 </office:automatic-styles>
 <office:body><office:text>
  <text:h text:style-name="Heading_20_1" text:outline-level="1">The First Chapter</text:h>
  <text:p text:style-name="Standard">Plain, <text:span text:style-name="B">bold</text:span>, <text:span text:style-name="I">italic</text:span>, and <text:span text:style-name="SC">small caps</text:span>.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>The first footnote.</text:p></text:note-body></text:note> A <text:a xlink:type="simple" xlink:href="https://example.org/">link</text:a> here.</text:p>
  <text:h text:style-name="Heading_20_2" text:outline-level="2">A Section</text:h>
  <text:list text:style-name="Bul">
   <text:list-item><text:p>Bullet one</text:p><text:list><text:list-item><text:p>Numbered inside</text:p></text:list-item></text:list></text:list-item>
   <text:list-item><text:p>Bullet two</text:p></text:list-item>
  </text:list>
  <text:p text:style-name="Quotations">A quoted line.</text:p>
  <text:p text:style-name="Standard">* * *</text:p>
  <table:table table:name="T"><table:table-column table:number-columns-repeated="2"/>
   <table:table-header-rows><table:table-row><table:table-cell><text:p>Name</text:p></table:table-cell><table:table-cell><text:p>Value</text:p></table:table-cell></table:table-row></table:table-header-rows>
   <table:table-row><table:table-cell><text:p>a</text:p></table:table-cell><table:table-cell><text:p>1</text:p></table:table-cell></table:table-row>
  </table:table>
  <text:p text:style-name="Standard"><draw:frame draw:name="Dot" text:anchor-type="as-char" svg:width="1cm" svg:height="1cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==</office:binary-data></draw:image><svg:title>A red dot</svg:title><svg:desc>A red dot</svg:desc></draw:frame></text:p>
  <text:h text:style-name="Heading_20_1" text:outline-level="1">The Second Chapter</text:h>
  <text:p text:style-name="Standard">More text.<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p>The endnote.</text:p></text:note-body></text:note></text:p>
  <text:list text:style-name="Num"><text:list-item><text:p>Step one</text:p></text:list-item><text:list-item><text:p>Step two</text:p></text:list-item></text:list>
 </office:text></office:body>
</office:document>
