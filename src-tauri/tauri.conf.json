{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainchant Scribe",
  "version": "0.1.0",
  "identifier": "io.plainchant.scribe",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plainchant Scribe — EPUB Studio",
        "url": "app.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "mimeType": "application/epub+zip",
        "name": "EPUB book",
        "description": "EPUB book",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
