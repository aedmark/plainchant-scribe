{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainchant Scribe",
  "version": "0.2.0",
  "identifier": "io.plainchant.scribe",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plainchant Scribe — EPUB Studio",
        "url": "app.html",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "mimeType": "application/epub+zip",
        "name": "EPUB book",
        "description": "EPUB book",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/plainchant-scribe.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/plainchant-scribe.desktop"
      }
    }
  }
}
